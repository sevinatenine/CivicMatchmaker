# CivicMatchmaker configuration.
# Copy to .env (gitignored) and fill in. Used by the npm scripts, the Python server
# (CivicAI/config.py) and the Cloudflare deploy. Never commit .env.

# ---------------------------------------------------------------- mode
# local  = API server runs on this machine (Julia 1 or OpenRouter, see LLM_PROVIDER)
# hosted = the dev app (Expo Go / web) talks to the deployed API at HOSTED_URL
# `npm run deploy` works in either mode. Only the web app is deployed; phones use Expo Go.
APP_ENV=local

# Decision model: "julia" (local Julia 1) or "openrouter" (works locally too, needs no torch).
# Leave empty to follow APP_ENV.
LLM_PROVIDER=

# ---------------------------------------------------------------- local decision model (Julia 1)
# Model folder, relative to CivicAI/. Device: cpu or cuda
JULIA_MODEL_DIR=Julia-1
JULIA_DEVICE=cpu

# ---------------------------------------------------------------- OpenRouter decision model
# Local: used when LLM_PROVIDER=openrouter. Hosted: also enter it in the Render dashboard.
OPENROUTER_API_KEY=
# microsoft/microsoft-decision-1 (fast, cheap)  or  typesafe/jev-1.14
OPENROUTER_MODEL=microsoft/microsoft-decision-1

# ---------------------------------------------------------------- data sources
# Local races, ballot measures and voting places. Enable "Google Civic Information API".
GOOGLE_CIVIC_API_KEY=

# ---------------------------------------------------------------- hosted mode (free plans)
# Web app on a Cloudflare Worker; the token needs "Workers Scripts: Edit"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# API server on Render (render.yaml), e.g. https://civicmatchmaker-api.onrender.com (no trailing slash)
BACKEND_URL=
# Your Worker's URL, printed by the first `npm run deploy`, e.g.
# https://civicmatchmaker.<your-subdomain>.workers.dev   (no trailing slash, no /api)
HOSTED_URL=

# ---------------------------------------------------------------- server tuning (optional)
PORT=4000
MAX_CONCURRENT=2
MAX_QUEUED=50
DEBUG=0
